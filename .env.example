# --- Envio do formulário de lead por e-mail ---
# O WhatsApp é o canal principal do site; o formulário gera poucos e-mails,
# então qualquer plano gratuito atende.
#
# Opção A — Web3Forms (padrão do projeto): 250 envios/mês grátis, sem backend.
#   1. Informe o e-mail em https://web3forms.com e receba a Access Key
#   2. VITE_LEAD_ACCESS_KEY=<sua-access-key>
#
# Endpoint padrão gratuito usado pelo app:
VITE_LEAD_ENDPOINT=https://api.web3forms.com/submit
VITE_LEAD_ACCESS_KEY=<sua-access-key>
